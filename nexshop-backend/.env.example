# Supabase (WAJIB tetap di .env — dipakai untuk konek ke DB itu sendiri,
# jadi gak bisa disimpan di dalam DB yang sama)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT
JWT_SECRET=

# AI summary untuk Gaming News. Wajib agar URL berbahasa Inggris maupun
# Indonesia otomatis mendapat ringkasan Indonesia 80–150 kata tanpa menyalin artikel.
OPENAI_API_KEY=
# Opsional; gunakan model yang tersedia pada akun OpenAI Anda.
OPENAI_NEWS_MODEL=gpt-5-mini

# Brevo (email OTP)
BREVO_API_KEY=
EMAIL_USER=

# Telegram (notifikasi pembelian) — buat bot lewat @BotFather di Telegram
# buat dapetin TELEGRAM_BOT_TOKEN, terus chat bot-nya (atau tambah ke grup)
# dan buka https://api.telegram.org/bot<TOKEN>/getUpdates buat nemuin
# TELEGRAM_CHAT_ID. Kosongin kalau gak mau pakai fitur ini.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp (notifikasi pembelian) — via WA Gateway waapi.fyas.my.id.
# 1. Buka https://waapi.fyas.my.id/dashboard buat generate API Key (wapi_...)
# 2. Buka https://waapi.fyas.my.id/, tempel API Key di kolom "Your API Key",
#    lalu scan QR code pakai WA (nomor resmi toko) via Settings > Linked
#    Devices > Link a Device. Status harus "Device Connected".
# 3. WAAPI_TARGET_NUMBER = nomor WA TUJUAN notifikasi (nomor resmi kamu
#    sendiri), format internasional TANPA tanda "+", contoh: 628123456789
# Kosongin salah satu (atau semua) kalau gak mau pakai fitur ini.
WAAPI_URL=https://waapi.fyas.my.id
WAAPI_KEY=
WAAPI_TARGET_NUMBER=

# URL frontend & backend kamu (dipakai buat returnUrl/cancelUrl/notifyUrl iPaymu).
# WAJIB diisi tanpa trailing slash. Karena sekarang di-deploy sendiri di VPS
# (bukan Railway/Netlify), biasanya frontend & backend satu domain yang sama
# (dibedain lewat path /api/ oleh nginx), contoh:
# FRONTEND_URL=https://nexshop.cloud
# BACKEND_URL=https://nexshop.cloud
FRONTEND_URL=
BACKEND_URL=

# iPaymu — nilai default/fallback. Bisa DIGANTI dari Settings > API Keys
# di admin dashboard tanpa redeploy; .env cuma dipakai kalau tabel api_keys
# masih kosong (fallback awal). Ambil VA & API Key di dashboard iPaymu:
# https://my.ipaymu.com (production) atau https://sandbox.ipaymu.com (testing)
# → menu Integrasi.
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_IS_PRODUCTION=false

# TokoVoucher — sama seperti iPaymu, ini fallback. Ambil Secret Key &
# Member Code di https://member.tokovoucher.net/pengaturan/secret-key
TOKOVOUCHER_MEMBER_CODE=
TOKOVOUCHER_SECRET=
