# Supabase (WAJIB tetap di .env — dipakai untuk konek ke DB itu sendiri,
# jadi gak bisa disimpan di dalam DB yang sama)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT
JWT_SECRET=

# Cloudflare Turnstile (WAJIB di production untuk login/registrasi).
# Setelah migration 014 dijalankan, isi/ubah dari Admin Dashboard > Settings >
# Login & Captcha tanpa restart atau edit VPS. Nilai .env ini hanya fallback
# awal/darurat. Site Key aman ditampilkan ke browser; Secret Key HANYA backend.
# TURNSTILE_ALLOWED_HOSTNAMES opsional, dipisahkan koma (contoh:
# nexshop.cloud,www.nexshop.cloud). Setelah diisi, respons dengan hostname
# lain akan ditolak oleh backend.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
# Development dapat mengaktifkan penegakan Turnstile secara eksplisit.
TURNSTILE_REQUIRED=false

# Google OAuth / OpenID Connect. Setelah migration 014 dijalankan, isi/ubah
# dari Admin Dashboard > Settings > Login & Captcha; .env hanya fallback.
# Daftarkan redirect URI berikut di Google Cloud Console:
# https://domain-kamu/api/auth/google/callback. Client Secret tidak pernah
# dikirim ke frontend.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Opsional. Jika kosong, BACKEND_URL/api/auth/google/callback dipakai.
GOOGLE_OAUTH_REDIRECT_URI=

# Google Gemini: dipakai NexBot (AI Customer Assistant) dan bantuan riset
# artikel NexShop News. Opsional -- kalau kosong, fitur terkait jatuh ke
# penyedia AI lain atau fallback tanpa AI.
GEMINI_API_KEY=
# Opsional; gunakan model Gemini yang tersedia pada akun Google AI Anda.
GEMINI_NEWS_MODEL=gemini-2.5-flash

# Groq AI untuk NexBot (AI Customer Assistant)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Brevo (email OTP)
BREVO_API_KEY=
EMAIL_USER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NexShop

# Telegram (notifikasi pembelian) — buat bot lewat @BotFather di Telegram
# buat dapetin TELEGRAM_BOT_TOKEN, terus chat bot-nya (atau tambah ke grup)
# dan buka https://api.telegram.org/bot<TOKEN>/getUpdates buat nemuin
# TELEGRAM_CHAT_ID. Kosongin kalau gak mau pakai fitur ini.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp — NexShop WA API (server Baileys sendiri, JALAN LOKAL di VPS yang
# sama, BUKAN gateway pihak ketiga lagi). Dipakai untuk semua pengiriman WA:
# OTP login/registrasi, notifikasi status pesanan/topup (pending/success/
# failed) ke USER, dan notifikasi aktivitas ke ADMIN.
#
# REKOMENDASI: atur URL/Key/Nomor tujuan lewat Admin Dashboard > Settings >
# API Keys (field "URL WA API Server" / "API Key WA API Server" / "Nomor
# Tujuan Notifikasi") — TERSIMPAN DI DATABASE, bukan di sini. Cocok kalau
# .env di lokal & di VPS beda / kamu gak bisa copy-paste .env ke VPS. Nilai
# di bawah ini HANYA fallback darurat kalau field di dashboard dikosongkan
# (misal pas awal setup sebelum sempat buka admin dashboard).
#
# 1. Jalankan service WA API (Baileys) dari folder wa-gateway-server/, contoh:
#    pm2 start ecosystem.config.cjs
# 2. Scan QR dari Admin NexShop > Settings > API Keys, memakai WhatsApp
#    nomor resmi toko via Settings > Linked Devices > Link a Device.
# 3. WA_API_URL = alamat service WA API tsb (default http://127.0.0.1:8080
#    kalau kosong). WA_API_KEY = API key custom buat proteksi endpoint
#    /send-otp & /send-transaction (HARUS SAMA persis dengan API key yang
#    dikonfig di service WA API-nya sendiri; wajib secret acak, bukan nilai
#    bawaan atau contoh dari dokumentasi).
# 4. WAAPI_TARGET_NUMBER = nomor WA TUJUAN notifikasi ADMIN (nomor resmi
#    kamu sendiri), format internasional TANPA tanda "+", contoh:
#    628123456789.
WA_API_URL=http://127.0.0.1:8080
WA_API_KEY=
WAAPI_TARGET_NUMBER=

# URL frontend & backend kamu (dipakai buat returnUrl/cancelUrl/notifyUrl iPaymu,
# DAN buat SSR meta-tag /berita/:slug serta sitemap.xml -- lihat
# controllers/ssrController.js & sitemapController.js).
# WAJIB diisi tanpa trailing slash. Karena sekarang di-deploy sendiri di VPS
# (bukan Railway/Netlify), biasanya frontend & backend satu domain yang sama
# (dibedain lewat path /api/ oleh nginx), contoh:
# FRONTEND_URL=https://nexshop.cloud
# BACKEND_URL=https://nexshop.cloud
FRONTEND_URL=
BACKEND_URL=

# Thumbnail SEO/Open Graph dibuat dari screenshot halaman live dan di-cache
# 5 menit. Konfigurasi utamanya dapat diisi dari Admin Dashboard > Settings >
# API Keys > SEO Thumbnail Live setelah migration 012 dijalankan. Nilai di
# bawah hanya fallback darurat. Chrome/Chromium tetap harus ter-install di VPS.
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
CHROME_EXECUTABLE_PATH=
# SEO_SCREENSHOT_BASE_URL=https://nexshop.cloud
SEO_SCREENSHOT_BASE_URL=

# Opsional -- path absolut ke folder nexshop-frontend, dipakai ssrController.js
# buat baca template berita-artikel.html. Default-nya otomatis nebak folder
# sibling (../../nexshop-frontend relatif dari controllers/), yang sudah
# cocok untuk struktur repo ini di VPS (nexshop-backend/ dan nexshop-frontend/
# bersebelahan). Isi ini CUMA kalau struktur deployment kamu beda dari itu.
# FRONTEND_DIST_PATH=/var/www/nexshop/frontend
FRONTEND_DIST_PATH=

# iPaymu — nilai default/fallback. Bisa DIGANTI dari Settings > API Keys
# di admin dashboard tanpa redeploy; .env cuma dipakai kalau tabel api_keys
# masih kosong (fallback awal). Ambil VA & API Key di dashboard iPaymu:
# https://my.ipaymu.com (production) atau https://sandbox.ipaymu.com (testing)
# → menu Integrasi.
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_IS_PRODUCTION=false

# TokoVoucher — sama seperti iPaymu, ini fallback. Ambil Secret Key &
# Member Code di https://member.tokovoucher.net/pengaturan/secret-key
TOKOVOUCHER_MEMBER_CODE=
TOKOVOUCHER_SECRET=
