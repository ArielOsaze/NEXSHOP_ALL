# Keep the gateway private. The default bind address exposes it only to this host.
PORT=8080
HOST=127.0.0.1

# API key tidak perlu disimpan di .env. Setelah gateway hidup, buka Admin →
# Settings → API Keys → Generate / Rotasi Key dari Dashboard. Key akan tersimpan
# pada file runtime di bawah dan tabel api_keys, tidak masuk ke repository.
WA_RUNTIME_CONFIG=/var/lib/nexshop-wa-api/gateway-config.json

# Keep this outside the repository and back it up securely. It contains the
# long-lived WhatsApp session keys produced after scanning the QR code.
WA_AUTH_DIR=/var/lib/nexshop-wa-api/auth

# Maximum accepted message length. This is deliberately not a bulk sender.
MAX_MESSAGE_LENGTH=4096
